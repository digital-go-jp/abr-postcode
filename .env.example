# DCAT Feed URL for ABR data (optional, defaults to official Digital Agency feed)
ABRP_FEED_URL=https://dataset.address-br.digital.go.jp/api/feed/dcat-us/1.1.json

# ABR data download URL (optional, defaults to ArcGIS endpoint)
ABRP_DATA_URL=https://www.arcgis.com/sharing/rest/content/items/1098a4f61dab4f52997839d04245132a/data

# Local data directory for storing downloaded files (optional, defaults to data/)
ABRP_DATA_DIR=data/
